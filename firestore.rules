rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isOwner(field) {
      return isSignedIn() && resource.data[field] == request.auth.uid;
    }

    // ---------- users: профили и роли ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'; // нельзя зарегистрироваться сразу админом
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role); // сам себя может менять, но не роль
      allow delete: if false;
    }

    // ---------- services: каталог, читают все, пишет только admin ----------
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- cars: машины пользователя, видит и меняет только владелец ----------
    match /cars/{id} {
      allow read, update, delete: if isOwner('ownerId');
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // ---------- bookings: заказы/бронирования ----------
    match /bookings/{id} {
      allow read: if isAdmin() || isOwner('userId');
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'draft';
      // владелец может подтвердить черновик или отменить активную запись;
      // admin может менять статус на любой (в т.ч. in_progress / done)
      allow update: if isAdmin()
                    || (isOwner('userId')
                        && resource.data.status in ['draft', 'confirmed']
                        && request.resource.data.status in ['confirmed', 'cancelled']);
      allow delete: if isAdmin() || (isOwner('userId') && resource.data.status == 'draft');
    }

    // ---------- reviews: отзывы к услугам ----------
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner('userId');
      allow delete: if isAdmin() || isOwner('userId');
    }
  }
}
